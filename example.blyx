use chunkspan;

fn main() {
    let size = 10.0;
    let width = 4.0;
    let index = 2.0;
    let result = chunkspan_bounds(size, width, index);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
